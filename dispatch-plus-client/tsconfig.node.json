{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    /* Plugins */
    "plugins": [
      {
        "name": "typescript-styled-plugin",
        "tags": [
          "styled",
          "createGlobalStyle",
          "css"
        ]
      }
    ],
  },
  "include": [
    "vite.config.ts"
  ]
}
